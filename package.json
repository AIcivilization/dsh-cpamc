{
  "name": "dsh-cpamc",
  "version": "0.1.0-alpha.7",
  "description": "Model provider for DeepSeek Harness (DSH): WorkBuddy, Trae, Qoder, ZCode and your Claude / Codex subscriptions behind one OpenAI-compatible endpoint, with a lightweight settings panel and the full management interface one click away. · DSH 的模型提供方：设置页轻量管理，「全部功能」一键打开完整管理界面。",
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "model-provider",
    "openai-compatible",
    "openai-api",
    "workbuddy",
    "trae",
    "qoder",
    "zcode",
    "codex",
    "claude",
    "self-hosted",
    "llm-tools"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-cpamc": "bin/dsh-cpamc.js"
  },
  "files": [
    "bin",
    "dist",
    "plugin",
    "engine-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/engine-contract",
    "pin-engine": "node scripts/pin-engine.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-cpamc.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "homepage": "https://github.com/AIcivilization/dsh-cpamc#readme",
  "bugs": {
    "url": "https://github.com/AIcivilization/dsh-cpamc/issues"
  },
  "author": "AIcivilization"
}
